{
  "name": "childcare-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "어린이집 AI 행정비서 — 데스크톱 프로토타입 (기록은 한 번, 문서는 AI가)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "electron:dev": "concurrently -k -n next,electron -c green,blue \"next dev\" \"wait-on http://localhost:3000 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "electron:preview": "next build && env -u ELECTRON_RUN_AS_NODE ELECTRON_USE_BUILD=1 electron .",
    "electron:build": "next build && electron-builder",
    "msw:init": "msw init public/ --save"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.451.0",
    "msw": "^2.6.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "5.6.3",
    "wait-on": "^8.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "build": {
    "appId": "kr.childcare.prototype",
    "productName": "어린이집 AI 행정비서",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dir"
    },
    "win": {
      "target": "dir"
    }
  }
}
