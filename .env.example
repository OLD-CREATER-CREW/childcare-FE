# 백엔드 API 베이스 URL (비우면 same-origin /api — MSW가 가로챔)
# 실 서버: https://api.child-care.site (국내 리전 상시 배포, 명세 r11 1.1)
# 실 서버는 로그인을 요구한다(명세 r11 1.2 — 액세스 JWT + 리프레시 토큰, Bearer 헤더).
# 토큰은 클라이언트가 보관하므로 여기에 넣을 자격 증명은 없다. 계정이 없으면
# 로그인 화면의 「어린이집 등록하기」(SCR-018)로 기관과 원장 계정을 만든다.
NEXT_PUBLIC_API_BASE_URL=

# 목(MSW) 응답을 쓰려면 명시적으로 "true"를 준다. 비어 있거나 다른 값이면 실 API를
# 호출한다 — 기본값이 목이면 배포 빌드에서 변수를 깜빡했을 때 인증이 통째로 우회된다.
# NEXT_PUBLIC_APP_ENV=production이면 이 값과 무관하게 목이 꺼진다.
NEXT_PUBLIC_USE_MOCK=false

NEXT_PUBLIC_APP_ENV=development

# 얼굴인식 추론 서버 주소 (lib/face 전용).
# 비우면 위 NEXT_PUBLIC_API_BASE_URL로 붙는다 — 배포 시에는 비워둔다.
# 개발 중 로컬에서 따로 띄웠다면(uvicorn ml.server.app:app --reload) 아래처럼 지정한다.
#   NEXT_PUBLIC_FACE_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FACE_API_BASE_URL=
