# 백엔드 API 베이스 URL (비우면 same-origin /api — MSW가 가로챔)
# 실 서버: https://api.child-care.site (국내 리전 상시 배포, 명세 r6 1.1)
# ⚠️ 실 서버는 현재 인증 미구현이라 아동 정보가 무인증 노출된다. 예시 기본값은
#    안전측(빈 URL·목 사용)으로 두고, 실 서버 연동은 .env.local에서 개별 설정한다.
NEXT_PUBLIC_API_BASE_URL=

# true면 MSW 목 응답 사용, false면 실제 API 호출
NEXT_PUBLIC_USE_MOCK=true

NEXT_PUBLIC_APP_ENV=development
